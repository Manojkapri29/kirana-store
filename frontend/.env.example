# Copy to `.env.local` (git-ignored) and adjust if needed.
# Only variables prefixed with VITE_ are exposed to the browser: never put secrets here.

# Base URL of the API. Leave empty in development so requests go through the Vite proxy.
# In production, set it to the deployed API origin (e.g. https://api.example.com).
VITE_API_BASE_URL=

# Where the Vite dev server forwards /api and /health requests.
VITE_DEV_API_PROXY_TARGET=http://127.0.0.1:8000
