# Secrets and local configuration (the *.example files ARE committed)
.env
.env.*
!.env.example

# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node / frontend build output
node_modules/
dist/
*.tsbuildinfo

# Local databases and backups (SQLite arrives in Phase 2). Shop data must never be committed.
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
backend/data/
backups/
exports/

# Logs
*.log

# OS / editors
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
