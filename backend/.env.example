# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
# All variables are read by app/core/config.py and use the KIRANA_ prefix.

# development | test | production. API docs (/docs) are disabled in production.
KIRANA_ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
KIRANA_LOG_LEVEL=INFO

# Comma-separated list of browser origins allowed to call the API.
KIRANA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database. SQLite for the MVP; relative paths are resolved against the backend/ folder.
# The file is created by `alembic upgrade head` and is git-ignored (backend/data/).
# PostgreSQL later, for example: postgresql+psycopg://user:password@host:5432/kirana
KIRANA_DATABASE_URL=sqlite:///./data/kirana.db

# Milliseconds a SQLite connection waits for another writer before failing with "database is locked".
KIRANA_DB_BUSY_TIMEOUT_MS=5000

# --- External price and product lookups (all optional; the app works fully without them) ---
# Backend only: these are read by the API server and never sent to the browser. Do not put them in any
# VITE_* variable, in frontend code, or in Git.

# Master switch. false = no outgoing request is ever made.
KIRANA_EXTERNAL_LOOKUPS_ENABLED=true
# Seconds to wait for a provider before giving up on it.
KIRANA_EXTERNAL_TIMEOUT_SECONDS=4
# Serve a price seen within this many hours from the shop's own saved copy (0 = always ask).
KIRANA_PRICE_CACHE_TTL_HOURS=24
# Open Food Facts asks apps to identify themselves. Use your own app name and a contact address.
KIRANA_OFF_USER_AGENT=ShopManager/0.1 (contact: you@example.com)

# UPCitemdb (paid plans use a key; leave the placeholder or leave it empty to keep it "not configured").
# Get a key from https://www.upcitemdb.com/ and put it in your own .env, never in this file.
UPCITEMDB_API_KEY=your_api_key_here

# --- Error diagnostics (Phase 9) ---
# Every unexpected error gets a reference id (ERR-YYYYMMDD-XXXXX) that a person can quote; the real cause is
# written, with secrets and paths removed, to the server log. Optionally also write it to its own file
# (JSON lines). Keep the file private: it is not shown in the app and there is no screen for it.
# KIRANA_DIAGNOSTICS_LOG_FILE=./data/diagnostics.log

# --- Photos / image intelligence (Phase 9, all optional; the app works fully without them) ---
# Limits that protect the server. Photos are stored only when the owner chooses to keep one, privately, in a
# folder that is never served directly (git-ignored: backend/data/).
KIRANA_IMAGE_MAX_BYTES=5000000
KIRANA_IMAGE_MAX_SIDE=8000
KIRANA_IMAGE_STORAGE_DIR=./data/images
KIRANA_IMAGE_MAX_PER_SHOP=500
# No image-analysis provider ships with the app. Until one is chosen and configured, the screen says
# "Image analysis is not configured yet." and everything else works. If you add one later, its key is backend
# only: never put it in a VITE_* variable, in frontend code, or in Git.
# KIRANA_IMAGE_ANALYSIS_PROVIDER=
IMAGE_ANALYSIS_API_KEY=your_api_key_here

# --- AI assistant (Phase 10, optional; the app works fully without it) ---
# Backend only. The key is read by the API server, never sent to the browser, logged, stored in the database or
# committed. Do not put it in any VITE_* variable, in frontend code, or in Git. With no provider set the assistant
# still answers its ready-made questions and says "AI Assistant is not configured." for free-form wording, and
# photographed documents say "Document analysis is not configured yet."
# Which provider: "anthropic" (Anthropic's Messages API). More can be added without changing anything else.
# KIRANA_AI_PROVIDER=anthropic
AI_API_KEY=your_api_key_here
# The provider's own model name (a sensible default is used when unset) and limits.
# KIRANA_AI_MODEL=
KIRANA_AI_TIMEOUT_SECONDS=20
KIRANA_AI_MAX_OUTPUT_TOKENS=1024

# --- Production readiness (Phase 11) ---
# development | test | production. In production the application REFUSES TO START unless the values below are safe.
# KIRANA_ENVIRONMENT=production
KIRANA_DEBUG=false
# "json" writes one JSON object per log line (for a log collector); "text" is for a terminal.
KIRANA_LOG_FORMAT=text
# The browser address of the frontend, and the origins allowed to call the API (must include the frontend, never "*").
# KIRANA_FRONTEND_URL=https://shop.example.com
# A long random value (at least 32 characters; for example: python -c "import secrets; print(secrets.token_urlsafe(48))").
# Required in production. Never commit it and never put it in a VITE_* variable.
# KIRANA_SECRET_KEY=

# Rate limiting: calls allowed per window, per shop (or per client address). Far above normal use.
KIRANA_RATE_LIMIT_ENABLED=true
KIRANA_RATE_LIMIT_WINDOW_SECONDS=60
KIRANA_RATE_LIMIT_AI=30
KIRANA_RATE_LIMIT_IMAGE=20
KIRANA_RATE_LIMIT_EXTERNAL=40
KIRANA_RATE_LIMIT_COUPON=600
KIRANA_RATE_LIMIT_EXPORT=20

# What a suspended or deactivated shop may do: "read_only" (look, not change) or "blocked" (only the account page).
KIRANA_SUSPENDED_POLICY=read_only
KIRANA_DEACTIVATED_POLICY=blocked

# Feature flags: switch a capability off for everyone (an emergency brake). All on by default.
KIRANA_FEATURE_AI=true
KIRANA_FEATURE_EXPORTS=true
KIRANA_FEATURE_NOTIFICATIONS=true
KIRANA_FEATURE_PRICE_LOOKUPS=true

# Backups (SQLite). Nothing leaves this machine unless a storage provider that does so is configured (only "local" exists).
KIRANA_BACKUP_DIR=./data/backups
KIRANA_BACKUP_STORAGE_PROVIDER=local
KIRANA_BACKUP_KEEP_DAILY_DAYS=14
KIRANA_BACKUP_KEEP_WEEKLY_WEEKS=8
KIRANA_BACKUP_MIN_FREE_MB=200
KIRANA_BACKUP_STALE_AFTER_HOURS=36
# Restoring over the live database from the web API is OFF unless you turn it on. The command line always works.
KIRANA_RESTORE_VIA_API_ENABLED=false

# Notifications: in-app always works. Other channels stay "not configured" until a provider is set up (none is bundled).
KIRANA_NOTIFICATION_MAX_ATTEMPTS=5
KIRANA_NOTIFICATION_BACKOFF_SECONDS=60
# KIRANA_NOTIFICATION_EMAIL_PROVIDER=
# KIRANA_NOTIFICATION_SMS_PROVIDER=
# KIRANA_NOTIFICATION_WHATSAPP_PROVIDER=
# KIRANA_NOTIFICATION_PUSH_PROVIDER=

# --- Sign-in, sessions and staff (Phase 12) ---
# A session ends after this long without use, and at the latest after the absolute limit, whatever the activity.
KIRANA_SESSION_IDLE_MINUTES=60
KIRANA_SESSION_ABSOLUTE_HOURS=12
# Secure cookies need HTTPS. Leave unset: it is on in production and off for plain-HTTP development.
# KIRANA_SESSION_COOKIE_SECURE=true
KIRANA_SESSION_COOKIE_SAMESITE=lax
# Wrong passwords in a row before an account is paused, and for how long. Sign-in attempts are also rate limited.
KIRANA_LOGIN_MAX_FAILURES=5
KIRANA_LOGIN_LOCKOUT_MINUTES=15
KIRANA_PASSWORD_MIN_LENGTH=10
KIRANA_INVITATION_EXPIRY_HOURS=72
# Argon2id cost. Production requires at least 19456 KiB and 2 passes; these defaults are stronger.
KIRANA_PASSWORD_HASH_TIME_COST=3
KIRANA_PASSWORD_HASH_MEMORY_KIB=65536
# Behind a reverse proxy that sets X-Forwarded-For: believe it. Otherwise leave false (a client could fake it).
KIRANA_TRUST_PROXY_HEADERS=false
# Development only: act as the seeded owner with no sign-in. Production refuses to start with this true.
KIRANA_DEV_AUTH_BYPASS=false
# The development owner's password when you run `python -m app.seed` (otherwise one is generated and shown once).
# KIRANA_DEV_OWNER_PASSWORD=

# --- Monitoring and background jobs (Phase 12) ---
# /metrics (Prometheus text format) does not exist unless enabled, and then needs this token (16+ characters).
KIRANA_METRICS_ENABLED=false
# KIRANA_METRICS_TOKEN=
KIRANA_JOB_MAX_ATTEMPTS=3
KIRANA_JOB_BACKOFF_SECONDS=30

# --- Integrations (Phase 17) ---
# Secrets for integrations live ONLY in variables whose names start with KIRANA_INTEGRATION_. A shop's integration stores the NAME of the
# variable (for example KIRANA_INTEGRATION_SMTP_PASSWORD), never the value; the application reads only variables with this prefix.
# Set the values here or, better, in your platform's secret manager. Examples (leave commented until you use them):
# KIRANA_INTEGRATION_SMTP_PASSWORD=
# KIRANA_INTEGRATION_SMS_TOKEN=
# KIRANA_INTEGRATION_WEBHOOK_SECRET=
# File storage: "local" (default, a private folder) or "s3" (any S3-compatible service; not verified against a live provider here).
KIRANA_STORAGE_PROVIDER=local
# KIRANA_STORAGE_S3_ENDPOINT=https://s3.example.com
# KIRANA_STORAGE_S3_BUCKET=
# KIRANA_STORAGE_S3_REGION=us-east-1
# KIRANA_STORAGE_S3_PATH_STYLE=true
# One variable holding ACCESS_KEY_ID:SECRET_ACCESS_KEY (its name must start KIRANA_INTEGRATION_):
# KIRANA_INTEGRATION_STORAGE_CREDENTIALS=
# Calls per window, per client address, to the public webhook endpoint.
KIRANA_RATE_LIMIT_WEBHOOK=120
