# Copy to `.env` and adjust. `.env` is git-ignored and must never be committed.
# All variables are read by app/core/config.py and use the KIRANA_ prefix.

# development | test | production. API docs (/docs) are disabled in production.
KIRANA_ENVIRONMENT=development

# DEBUG | INFO | WARNING | ERROR
KIRANA_LOG_LEVEL=INFO

# Comma-separated list of browser origins allowed to call the API.
KIRANA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database. SQLite for the MVP; relative paths are resolved against the backend/ folder.
# The file is created by `alembic upgrade head` and is git-ignored (backend/data/).
# PostgreSQL later, for example: postgresql+psycopg://user:password@host:5432/kirana
KIRANA_DATABASE_URL=sqlite:///./data/kirana.db

# Milliseconds a SQLite connection waits for another writer before failing with "database is locked".
KIRANA_DB_BUSY_TIMEOUT_MS=5000

# --- External price and product lookups (all optional; the app works fully without them) ---
# Backend only: these are read by the API server and never sent to the browser. Do not put them in any
# VITE_* variable, in frontend code, or in Git.

# Master switch. false = no outgoing request is ever made.
KIRANA_EXTERNAL_LOOKUPS_ENABLED=true
# Seconds to wait for a provider before giving up on it.
KIRANA_EXTERNAL_TIMEOUT_SECONDS=4
# Serve a price seen within this many hours from the shop's own saved copy (0 = always ask).
KIRANA_PRICE_CACHE_TTL_HOURS=24
# Open Food Facts asks apps to identify themselves. Use your own app name and a contact address.
KIRANA_OFF_USER_AGENT=ShopManager/0.1 (contact: you@example.com)

# UPCitemdb (paid plans use a key; leave the placeholder or leave it empty to keep it "not configured").
# Get a key from https://www.upcitemdb.com/ and put it in your own .env, never in this file.
UPCITEMDB_API_KEY=your_api_key_here

# Added in a later phase (do not set yet):
#   Phase 14 - KIRANA_SECRET_KEY   (generate a long random value; never commit it)
